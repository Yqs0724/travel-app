generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Trip {
  id          String          @id @default(cuid())
  title       String
  startDate   DateTime
  endDate     DateTime
  members     String // JSON: ["我","张三"]
  currency    String          @default("CNY")
  editVersion Int             @default(0) // 弱协作乐观锁
  days        TripDay[]
  expenses    Expense[]
  budgetPlans BudgetPlanItem[]
  checklist   ChecklistItem[]
  shareLinks  ShareLink[]
  /** AI 草稿待定参考 JSON：[{id,name,startTime?,dayLabel?,...}]，不入行程 */
  pendingJson String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model TripDay {
  id     String          @id @default(cuid())
  tripId String
  date   DateTime
  note   String?
  trip   Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items  ItineraryItem[]

  @@unique([tripId, date])
}

model ItineraryItem {
  id            String         @id @default(cuid())
  dayId         String
  seq           Int
  poiId         String?
  poi           POI?           @relation(fields: [poiId], references: [id])
  customName    String?
  startTime     String?
  durationMin   Int?
  ticketPrice   Float?
  needBook      Boolean        @default(false)
  bookAheadDays Int?
  /** 提醒时刻 YYYY-MM-DDTHH:mm；有则优先于 bookAheadDays */
  bookRemindAt  String?
  /** 预约方式备注：链接 / 公众号 / 电话等，自由文本 */
  bookUrl       String?
  note          String?
  /** 地图上不画这个点；前后景点仍连线。不改已存路段 */
  mapHidden     Boolean        @default(false)
  day           TripDay        @relation(fields: [dayId], references: [id], onDelete: Cascade)
  legToNext     TransportLeg?
}

model POI {
  id        String          @id @default(cuid())
  amapId    String?         @unique
  name      String
  lng       Float
  lat       Float
  city      String?
  category  String?
  openHours String?
  rawJson   String?
  items     ItineraryItem[]
}

model TransportLeg {
  id          String         @id @default(cuid())
  fromItemId  String         @unique
  mode        String
  distanceM   Int?
  durationMin Int?
  cost        Float?
  fromItem    ItineraryItem  @relation(fields: [fromItemId], references: [id], onDelete: Cascade)
}

model Expense {
  id         String         @id @default(cuid())
  tripId     String
  category   String
  amount     Float
  payer      String
  itemId     String?
  date       DateTime
  note       String?
  receiptExt String? // jpg|png|webp，有值即有附图
  splits     ExpenseSplit[]
  trip       Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model ExpenseSplit {
  id        String  @id @default(cuid())
  expenseId String
  member    String
  ratio     Float   @default(1)
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

/** 预计花费清单（预算）；植入实付后仍保留，仅标记 implanted */
model BudgetPlanItem {
  id          String  @id @default(cuid())
  tripId      String
  name        String
  /** 账单总额（录入值；共同支出时为整单） */
  amount      Float
  /** 已植入实付账本（条目保留垫底，不删） */
  implanted   Boolean @default(false)
  /** 植入时「我」承担额；未植入为 null（合计用 amount） */
  myShare     Float?
  /** 植入时勾选的朋友数（>0 即共同） */
  friendCount Int     @default(0)
  trip        Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model ChecklistItem {
  id         String  @id @default(cuid())
  tripId     String
  category   String
  name       String
  /** 已购买 */
  purchased  Boolean @default(false)
  /** 已携带（原 checked） */
  checked    Boolean @default(false)
  source     String  @default("custom")
  trip       Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model ShareLink {
  id           String    @id @default(cuid())
  tripId       String
  token        String    @unique
  canEdit      Boolean   @default(false)
  /** trip=行程只读；aa=仅共同支出账单 */
  kind         String    @default("trip")
  passwordHash String? // 历史字段；协作已无密码
  expiresAt    DateTime?
  trip         Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
}
